# Synthetic local-development values only. Do not put production credentials here.
POSTGRES_PORT=55432
POSTGRES_DB=kostak
POSTGRES_USER=kostak
POSTGRES_PASSWORD=kostak-local-only

# Runtime contract. APP_MODE is one of api, worker, or migrate.
APP_MODE=api
APP_ENV=local
APP_RELEASE_SHA=local-dev
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000
APP_WORKER_HEARTBEAT_MAX_AGE_SECONDS=90
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=local

# Spring Boot reads these values when they are exported in the current shell.
# Local PostgreSQL intentionally has no TLS; staging/production reject URLs without
# sslmode=require, verify-ca, or verify-full.
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:55432/kostak
SPRING_DATASOURCE_USERNAME=kostak
SPRING_DATASOURCE_PASSWORD=kostak-local-only
SPRING_DATASOURCE_HIKARI_MAXIMUM_POOL_SIZE=4
SPRING_FLYWAY_ENABLED=false

# Supabase Auth contract only; IAM-001 will implement JWT enforcement.
# Leave these empty for local scaffold work. Never place service_role keys here.
SUPABASE_URL=
SUPABASE_JWT_ISSUER=
SUPABASE_JWKS_URL=
SUPABASE_JWT_AUDIENCE=authenticated

# Browser-visible frontend configuration. These values are not secrets.
# Copy the frontend subset to frontend/.env.local for local Next.js development.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
